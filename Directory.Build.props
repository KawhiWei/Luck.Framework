<Project>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Luck.TestBase.SourceGenerator'">
		<BaseIntermediateOutputPath>obj\Luck.TestBase.SourceGenerator\</BaseIntermediateOutputPath>
		<MSBuildProjectExtensionsPath>obj\Luck.TestBase.SourceGenerator\</MSBuildProjectExtensionsPath>
		<BaseOutputPath>bin\Luck.TestBase.SourceGenerator\</BaseOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>NU1803;CS1591;CS0108;</NoWarn>
	</PropertyGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
	</ItemGroup >
</Project>
